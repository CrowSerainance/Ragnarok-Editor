<Window x:Class="RoDbEditor.Dialogs.MobSkillEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Monster Skill" Width="560" Height="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with info icon -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Monster Skill Entry" FontSize="16" FontWeight="Bold"
                       Foreground="#89B4FA" VerticalAlignment="Center"/>
            <TextBlock Text="ⓘ" FontSize="14" Foreground="#89B4FA" Margin="8,0,0,0"
                       Cursor="Help" VerticalAlignment="Center"
                       ToolTipService.ToolTip="Import overlay: writes to db/import/mob_skill_db.txt only. When editing mobs, Drops merge with base (max 10). See doc-map-server-drop-limit-analysis.md"/>
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 0: Mob ID -->
                    <RowDefinition Height="Auto"/>  <!-- 1: Skill ID -->
                    <RowDefinition Height="Auto"/>  <!-- 2: Skill Level -->
                    <RowDefinition Height="Auto"/>  <!-- 3: State -->
                    <RowDefinition Height="Auto"/>  <!-- 4: Rate -->
                    <RowDefinition Height="Auto"/>  <!-- 5: Cast Time -->
                    <RowDefinition Height="Auto"/>  <!-- 6: Delay -->
                    <RowDefinition Height="Auto"/>  <!-- 7: Cancelable -->
                    <RowDefinition Height="Auto"/>  <!-- 8: Target -->
                    <RowDefinition Height="Auto"/>  <!-- 9: Condition Type -->
                    <RowDefinition Height="Auto"/>  <!-- 10: Condition Value -->
                    <RowDefinition Height="Auto"/>  <!-- 11: Val1-Val5 -->
                    <RowDefinition Height="Auto"/>  <!-- 12: Val hint -->
                    <RowDefinition Height="Auto"/>  <!-- 13: Emotion -->
                    <RowDefinition Height="Auto"/>  <!-- 14: Chat -->
                    <RowDefinition Height="Auto"/>  <!-- 15: Spacer -->
                    <RowDefinition Height="Auto"/>  <!-- 16: Info -->
                </Grid.RowDefinitions>

                <!-- Row 0: Mob ID (read-only) -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mob ID"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="TxtMobId" Width="80" IsReadOnly="True" Background="#313244" Foreground="#A6ADC8"/>
                    <TextBlock x:Name="LblMobName" Margin="8,0,0,0" Foreground="#A6ADC8" FontStyle="Italic"/>
                </StackPanel>

                <!-- Row 1: Skill ID (searchable: type ID or name to filter) -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Skill ID"/>
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="CmbSkillId" Width="300" IsEditable="True"
                                  IsTextSearchEnabled="False" MaxDropDownHeight="280"
                                  StaysOpenOnEdit="True"
                                  SelectionChanged="CmbSkillId_SelectionChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="LblSkillName" Foreground="#A6E3A1" FontSize="11" FontStyle="Italic" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Row 2: Skill Level -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Skill Level"/>
                <TextBox x:Name="TxtSkillLv" Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left"/>

                <!-- Row 3: State -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="State"/>
                <ComboBox x:Name="CmbState" Grid.Row="3" Grid.Column="1" IsEditable="True"/>

                <!-- Row 4: Rate -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Rate (0-10000)"/>
                <TextBox x:Name="TxtRate" Grid.Row="4" Grid.Column="1" Width="80" HorizontalAlignment="Left"/>

                <!-- Row 5: Cast Time -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Cast Time (ms)"/>
                <TextBox x:Name="TxtCastTime" Grid.Row="5" Grid.Column="1" Width="80" HorizontalAlignment="Left"/>

                <!-- Row 6: Delay -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Delay (ms)"/>
                <TextBox x:Name="TxtDelay" Grid.Row="6" Grid.Column="1" Width="80" HorizontalAlignment="Left"/>

                <!-- Row 7: Cancelable -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Cancelable"/>
                <CheckBox x:Name="ChkCancelable" Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" Margin="0,4"/>

                <!-- Row 8: Target -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="Target"/>
                <ComboBox x:Name="CmbTarget" Grid.Row="8" Grid.Column="1" IsEditable="True"/>

                <!-- Row 9: Condition Type -->
                <TextBlock Grid.Row="9" Grid.Column="0" Text="Condition"/>
                <ComboBox x:Name="CmbConditionType" Grid.Row="9" Grid.Column="1" IsEditable="True"/>

                <!-- Row 10: Condition Value -->
                <TextBlock Grid.Row="10" Grid.Column="0" Text="Cond Value"/>
                <TextBox x:Name="TxtConditionValue" Grid.Row="10" Grid.Column="1" Width="80" HorizontalAlignment="Left"/>

                <!-- Row 11: Val1-Val5 -->
                <TextBlock Grid.Row="11" Grid.Column="0" Text="Val1-Val5"/>
                <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="TxtVal1" Width="60" Margin="0,2,4,2"/>
                    <TextBox x:Name="TxtVal2" Width="60" Margin="0,2,4,2"/>
                    <TextBox x:Name="TxtVal3" Width="60" Margin="0,2,4,2"/>
                    <TextBox x:Name="TxtVal4" Width="60" Margin="0,2,4,2"/>
                    <TextBox x:Name="TxtVal5" Width="60" Margin="0,2,0,2"/>
                </StackPanel>

                <!-- Row 12: Val hint (contextual, updates with skill ID) -->
                <TextBlock x:Name="LblValHint" Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"
                           Foreground="#6C7086" FontSize="11" FontStyle="Italic" Margin="0,0,0,4"/>

                <!-- Row 13: Emotion -->
                <TextBlock Grid.Row="13" Grid.Column="0" Text="Emotion"/>
                <TextBox x:Name="TxtEmotion" Grid.Row="13" Grid.Column="1" Width="80" HorizontalAlignment="Left"/>

                <!-- Row 14: Chat -->
                <TextBlock Grid.Row="14" Grid.Column="0" Text="Chat"/>
                <TextBox x:Name="TxtChat" Grid.Row="14" Grid.Column="1"/>

                <!-- Row 15: Spacer -->
                <TextBlock Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="2" Text="" Height="8"/>

                <!-- Row 16: Info label -->
                <TextBlock Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="Writes to db/import/mob_skill_db.txt only. Type ID or name to search skills."
                           Foreground="#6C7086" FontSize="11" FontStyle="Italic"/>
            </Grid>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Padding="4,6" Margin="0,0,8,0" Click="BtnOk_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Padding="4,6" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
