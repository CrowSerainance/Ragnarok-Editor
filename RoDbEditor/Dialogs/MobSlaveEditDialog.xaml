<Window x:Class="RoDbEditor.Dialogs.MobSlaveEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Summon Slave" Width="520" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with info icon -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Summon Slave Entry" FontSize="16" FontWeight="Bold"
                       Foreground="#89B4FA" VerticalAlignment="Center"/>
            <TextBlock x:Name="InfoIcon" Text="ⓘ" FontSize="14" Foreground="#89B4FA" Margin="8,0,0,0"
                       Cursor="Help" VerticalAlignment="Center"
                       ToolTipService.ToolTip="Import overlay: slave entries write to db/import/mob_skill_db.txt only. When editing mobs in import, note that Drops merge with base (max 10). See doc-map-server-drop-limit-analysis.md"/>
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Mob ID (read-only) -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mob ID"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="TxtMobId" Width="80" IsReadOnly="True" Background="#313244" Foreground="#A6ADC8"/>
                    <TextBlock x:Name="LblMobName" Margin="8,0,0,0" Foreground="#A6ADC8" FontStyle="Italic"/>
                </StackPanel>

                <!-- Row 1: Skill (locked to NPC_SUMMONSLAVE) -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Skill"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="NPC_SUMMONSLAVE (196)" Foreground="#A6E3A1" FontWeight="SemiBold"/>

                <!-- Row 2: Slave 1 (searchable: type ID or name to filter) -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Slave 1"/>
                <ComboBox x:Name="CmbSlave1" Grid.Row="2" Grid.Column="1" IsEditable="True" StaysOpenOnEdit="True"
                          KeyUp="CmbSlave_KeyUp" MaxDropDownHeight="220"/>

                <!-- Row 3: Slave 2 -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Slave 2"/>
                <ComboBox x:Name="CmbSlave2" Grid.Row="3" Grid.Column="1" IsEditable="True" StaysOpenOnEdit="True"
                          KeyUp="CmbSlave_KeyUp" MaxDropDownHeight="220"/>

                <!-- Row 4: Slave 3 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Slave 3"/>
                <ComboBox x:Name="CmbSlave3" Grid.Row="4" Grid.Column="1" IsEditable="True" StaysOpenOnEdit="True"
                          KeyUp="CmbSlave_KeyUp" MaxDropDownHeight="220"/>

                <!-- Row 5: Slave 4 -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Slave 4"/>
                <ComboBox x:Name="CmbSlave4" Grid.Row="5" Grid.Column="1" IsEditable="True" StaysOpenOnEdit="True"
                          KeyUp="CmbSlave_KeyUp" MaxDropDownHeight="220"/>

                <!-- Row 6: Slave 5 -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Slave 5"/>
                <ComboBox x:Name="CmbSlave5" Grid.Row="6" Grid.Column="1" IsEditable="True" StaysOpenOnEdit="True"
                          KeyUp="CmbSlave_KeyUp" MaxDropDownHeight="220"/>

                <!-- Row 7: Total Summon Count -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Total Count"/>
                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="TxtTotalCount" Width="80"/>
                    <TextBlock Margin="8,0,0,0" Foreground="#6C7086" FontSize="11" FontStyle="Italic"
                               Text="Distributed round-robin across slave types"/>
                </StackPanel>

                <!-- Row 8: State -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="State"/>
                <ComboBox x:Name="CmbState" Grid.Row="8" Grid.Column="1" IsEditable="True"/>

                <!-- Row 9: Rate -->
                <TextBlock Grid.Row="9" Grid.Column="0" Text="Rate (0-10000)"/>
                <TextBox x:Name="TxtRate" Grid.Row="9" Grid.Column="1" Width="80" HorizontalAlignment="Left"/>

                <!-- Row 10: Condition -->
                <TextBlock Grid.Row="10" Grid.Column="0" Text="Condition"/>
                <ComboBox x:Name="CmbConditionType" Grid.Row="10" Grid.Column="1" IsEditable="True"/>

                <!-- Row 11: Condition Value -->
                <TextBlock Grid.Row="11" Grid.Column="0" Text="Cond Value"/>
                <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="TxtConditionValue" Width="80"/>
                    <TextBlock Margin="8,0,0,0" Foreground="#6C7086" FontSize="11" FontStyle="Italic"
                               Text="e.g. max slaves before re-summoning"/>
                </StackPanel>

                <!-- Row 12: Info -->
                <TextBlock Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="Target locked to 'self'. Writes to db/import/mob_skill_db.txt only. Type ID or name to search slaves."
                           Foreground="#6C7086" FontSize="11" FontStyle="Italic" Margin="0,8,0,0"/>
            </Grid>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Padding="4,6" Margin="0,0,8,0" Click="BtnOk_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Padding="4,6" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
