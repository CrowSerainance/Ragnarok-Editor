                                            <ComboBoxItem Content="Healing"/>
                                            <ComboBoxItem Content="Usable"/>
                                            <ComboBoxItem Content="Etc"/>
                                            <ComboBoxItem Content="Weapon"/>
                                            <ComboBoxItem Content="Armor"/>
                                            <ComboBoxItem Content="Card"/>
