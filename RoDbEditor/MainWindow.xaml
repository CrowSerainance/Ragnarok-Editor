<Window x:Class="RoDbEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoDbEditor"
        xmlns:controls="clr-namespace:RoDbEditor.Core.Controls"
        xmlns:avalon="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
        xmlns:vm="clr-namespace:RoDbEditor.ViewModels"
        mc:Ignorable="d"
        Title="RoDbEditor (GRF-based) — RateMyServer-style DB Editor" Height="720" Width="1280"
        MinHeight="500" MinWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="Select rAthena folder..." Click="MenuOpenDataFolder_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Asset Browser" IsChecked="True" IsCheckable="True"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Analyze Workspace" Click="OnAnalyzeClicked"/>
                <MenuItem Header="Analyze Folder..." Click="OnAnalyzeFolderClicked"/>
                <MenuItem Header="Open GRF..." Click="MenuOpenGrf_Click"/>
                <Separator/>
                <MenuItem Header="Open Client Folder..." Click="OpenClientFolder_Click"/>
                <MenuItem Header="Set Client Patch Output..." Click="SetClientPatchOutput_Click"/>
                <Separator/>
                <MenuItem Header="Copy Custom Output (Item)" Click="CopyCustomOutputItem_Click"/>
                <MenuItem Header="Copy Custom Output (Mob)" Click="CopyCustomOutputMob_Click"/>
                <MenuItem Header="Copy Custom Output (NPC)" Click="CopyCustomOutputNpc_Click"/>
                <Separator/>
                <MenuItem Header="Write itemInfo_rodbeditor.lua" Click="WriteItemInfoOverlay_Click"/>
                <MenuItem Header="Append mob_avail override" Click="AppendMobAvail_Click"/>
                <MenuItem Header="Append npcidentity/jobname overlay" Click="AppendNpcIdentity_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Sprite Diagnostic..." Click="MenuSpriteDiagnostic_Click"/>
                <MenuItem Header="About RoDbEditor"/>
            </MenuItem>
        </Menu>

        <!-- Tabs: ITEMS, MONSTERS, NPCs, MAPS, QUESTS -->
        <TabControl x:Name="CategoryTabs" Grid.Row="1" Margin="8,4" SelectedIndex="0" SelectionChanged="CategoryTabs_SelectionChanged">
            <TabItem Header="ITEMS"/>
            <TabItem Header="MONSTERS"/>
            <TabItem Header="NPCs"/>
            <TabItem Header="MAPS"/>
            <TabItem Header="QUESTS"/>
            <TabItem Header="FILE ASSIGNMENT"/>
        </TabControl>

        <!-- List | Preview | Details (RateMyServer-style 3-panel) -->
        <Grid Grid.Row="2" Margin="6" x:Name="MainContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180" MaxWidth="500"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="200" MaxWidth="400"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Search + virtualized list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="SEARCH:" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Grid.Column="0" Margin="0,0,4,0" Padding="4,2"
                                 VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown"/>
                        <Button x:Name="TypeFilterButton" Grid.Column="1" Content="TYPE ▼" Margin="0,0,4,0" Padding="8,2"/>
                        <Button x:Name="SearchButton" Grid.Column="2" Content="SEARCH" Padding="8,2" Click="SearchButton_Click"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <StackPanel x:Name="NpcMapFilterPanel" Visibility="Collapsed">
                        <TextBlock Text="MAP:" Margin="0,0,0,4"/>
                        <ComboBox x:Name="NpcMapCombo" Margin="0,0,0,8" SelectionChanged="NpcMapCombo_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="CurrentListLabel" Text="CURRENT LIST: ITEMS" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="RefreshListButton" Content="Refresh" Padding="8,2" Margin="8,0,0,0" Click="RefreshListButton_Click" FontSize="11"/>
                        <Button x:Name="CreateNewButton" Content="+ NEW" Padding="8,2" Margin="4,0,0,0" Click="CreateNewButton_Click" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="AssetListBox" Grid.Row="2" DisplayMemberPath="DisplayName" SelectedValuePath="Path"
                         SelectionChanged="AssetListBox_SelectionChanged"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"/>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#c0c0c0"
                          ResizeDirection="Columns" ShowsPreview="False" DragIncrement="1"/>

            <!-- Center: Preview (static BMP/PAL + ACT/SPR; SpritePreviewPanel removed for extracted assets) -->
            <Expander Grid.Column="2" Header="PREVIEW" IsExpanded="True" Margin="0">
                <GroupBox BorderThickness="0" Padding="0" Margin="0">
                    <Grid x:Name="CenterPreviewGrid" Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="StaticPreviewPanel" Grid.Row="0" Background="#2a2a2a" CornerRadius="6">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="8">
                                <Image x:Name="CenterPreviewImage" Stretch="None" SnapsToDevicePixels="True"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Viewbox>
                        </Border>

                        <Border x:Name="SpritePreviewPanel" Grid.Row="2" Background="#2a2a2a" CornerRadius="6" Visibility="Collapsed">
                            <controls:SpriteAnimationViewer x:Name="SpriteViewer"/>
                        </Border>
                    </Grid>
                </GroupBox>
            </Expander>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="#c0c0c0"
                          ResizeDirection="Columns" ShowsPreview="False" DragIncrement="1"/>

            <!-- Right: Details panel (fields + script + Save/Export/Cancel) -->
            <Border Grid.Column="4" BorderBrush="#ccc" BorderThickness="1" Padding="12" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Source indicators strip (always visible) -->
                        <Border Background="#f0f0f0" Padding="8,6" Margin="0,0,0,8" CornerRadius="4">
                            <StackPanel>
                                <TextBlock x:Name="SourceIndicator1" FontSize="11" Text="GRF: Not loaded" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                <TextBlock x:Name="SourceIndicator2" FontSize="11" Text="rAthena: Not set" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                <TextBlock x:Name="SourceIndicator3" FontSize="11" Text="Items: None" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <!-- Item details (ITEMS tab) - full property editor -->
                        <StackPanel x:Name="ItemDetailsPanel">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="ITEM PROPERTIES" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text=" (i)" FontSize="12" Foreground="#89B4FA" Cursor="Help"
                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                           ToolTipService.InitialShowDelay="0"
                                           ToolTipService.ShowDuration="60000">
                                    <TextBlock.ToolTip>
                                        <ToolTip MaxWidth="480">
                                            <TextBlock TextWrapping="Wrap" Text="ITEM PROPERTIES — Field Guide&#x0a;&#x0a;This panel shows all editable properties for the selected item from rAthena's item database.&#x0a;&#x0a;• Item ID: Read-only unique ID. Existing items keep their ID; new items get the next available custom ID.&#x0a;• AegisName: Internal code name used in scripts and commands (max 49 chars, no spaces).&#x0a;• Name: Display name shown in-game to players (max 49 chars).&#x0a;• Type: Item category. Determines which fields are relevant: Weapon → Attack, MagicAttack, Range, WeaponLevel, SubType; Armor → Defense, ArmorLevel, Locations; ShadowGear → Defense, Shadow_* locations; Ammo → Attack, SubType; Card → SubType (Normal/Enchant); Others → mostly stat-free (Healing, Usable, Etc, Cash, etc.)&#x0a;• SubType: Weapon type (Dagger, 1hSword…), Ammo type (Arrow, Bullet…), or Card type. Only valid for those three Types — blank for everything else.&#x0a;• Buy/Sell: NPC prices in Zeny. Rule: if Buy/124 &lt; Sell/75, server forces Sell=1.&#x0a;• Weight: 10 units = 1.0 displayed in-game.&#x0a;• Attack/MagicAttack: Physical/magic ATK (Weapon &amp; Ammo only).&#x0a;• Defense: DEF value (Armor &amp; ShadowGear only). Max 32767.&#x0a;• Range: Attack range in cells (Weapon only).&#x0a;• Slots: Card slots (0-4).&#x0a;• EquipLevelMin/Max: Required character level range (0-275). Max must be ≥ Min.&#x0a;• WeaponLevel: Weapon tier 0-5 (Weapon only). ArmorLevel: Armor tier 0-2 (Armor only).&#x0a;• Gender: Both/Male/Female. Musical=Male, Whip=Female (forced by server).&#x0a;• View: Sprite view ID. AliasName: Borrow another item's appearance.&#x0a;• Refineable/Gradable: Can this item be refined (+1, +2…) or graded.&#x0a;• Jobs: Which job classes can equip/use. Check 'All' for no restriction.&#x0a;• Locations: Which equip slot (Head_Top, Armor, Right_Hand, Shadow_Armor, etc.).&#x0a;• Script/EquipScript/UnEquipScript: rAthena script code for bonuses and effects.&#x0a;• SAVE: Writes changes to the item's source YAML file (db/import/item_db.yml for custom items).&#x0a;&#x0a;All validations are checked automatically on save — invalid fields are auto-corrected with a warning dialog."/>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Item ID:" Margin="0,2" VerticalAlignment="Center"/>
                                <TextBox x:Name="ItemEditId" Grid.Row="0" Grid.Column="1" Padding="2" Margin="0,2" IsReadOnly="True" Background="#e8e8e8"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="AegisName:" Margin="0,2" VerticalAlignment="Center"/>
                                <TextBox x:Name="ItemEditAegisName" Grid.Row="1" Grid.Column="1" Padding="2" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Name:" Margin="0,2" VerticalAlignment="Center"/>
                                <TextBox x:Name="ItemEditName" Grid.Row="2" Grid.Column="1" Padding="2" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Type:" Margin="0,2" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ItemEditType" Grid.Row="3" Grid.Column="1" IsEditable="True" Margin="0,2" SelectionChanged="ItemEditType_SelectionChanged">
                                    <ComboBoxItem Content="Healing"/><ComboBoxItem Content="Usable"/><ComboBoxItem Content="Etc"/><ComboBoxItem Content="Weapon"/><ComboBoxItem Content="Armor"/>
                                    <ComboBoxItem Content="Card"/><ComboBoxItem Content="PetEgg"/><ComboBoxItem Content="PetArmor"/><ComboBoxItem Content="Ammo"/><ComboBoxItem Content="DelayConsume"/><ComboBoxItem Content="Cash"/><ComboBoxItem Content="ShadowGear"/>
                                </ComboBox>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="SubType:" Margin="0,2" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ItemEditSubType" Grid.Row="4" Grid.Column="1" IsEditable="True" Margin="0,2"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Buy:" Margin="0,2" VerticalAlignment="Center"/>
                                <TextBox x:Name="ItemEditBuy" Grid.Row="5" Grid.Column="1" Padding="2" Margin="0,2" Width="80" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Sell:" Margin="0,2" VerticalAlignment="Center"/>
                                <TextBox x:Name="ItemEditSell" Grid.Row="6" Grid.Column="1" Padding="2" Margin="0,2" Width="80" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Weight:" Margin="0,2" VerticalAlignment="Center"/>
                                <TextBox x:Name="ItemEditWeight" Grid.Row="7" Grid.Column="1" Padding="2" Margin="0,2" Width="80" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Attack:" Margin="0,2" VerticalAlignment="Center"/>
                                <TextBox x:Name="ItemEditAttack" Grid.Row="8" Grid.Column="1" Padding="2" Margin="0,2" Width="80" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="MagicAttack:" Margin="0,2" VerticalAlignment="Center"/>
                                <TextBox x:Name="ItemEditMagicAttack" Grid.Row="9" Grid.Column="1" Padding="2" Margin="0,2" Width="80" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Defense:" Margin="0,2" VerticalAlignment="Center"/>
                                <TextBox x:Name="ItemEditDefense" Grid.Row="10" Grid.Column="1" Padding="2" Margin="0,2" Width="80" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="Range:" Margin="0,2" VerticalAlignment="Center"/>
                                <TextBox x:Name="ItemEditRange" Grid.Row="11" Grid.Column="1" Padding="2" Margin="0,2" Width="80" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="Slots:" Margin="0,2" VerticalAlignment="Center"/>
                                <TextBox x:Name="ItemEditSlots" Grid.Row="12" Grid.Column="1" Padding="2" Margin="0,2" Width="60" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="13" Grid.Column="0" Text="EquipLevelMin:" Margin="0,2" VerticalAlignment="Center"/>
                                <TextBox x:Name="ItemEditEquipLevelMin" Grid.Row="13" Grid.Column="1" Padding="2" Margin="0,2" Width="80" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="14" Grid.Column="0" Text="EquipLevelMax:" Margin="0,2" VerticalAlignment="Center"/>
                                <TextBox x:Name="ItemEditEquipLevelMax" Grid.Row="14" Grid.Column="1" Padding="2" Margin="0,2" Width="80" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="15" Grid.Column="0" Text="WeaponLevel:" Margin="0,2" VerticalAlignment="Center"/>
                                <TextBox x:Name="ItemEditWeaponLevel" Grid.Row="15" Grid.Column="1" Padding="2" Margin="0,2" Width="80" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="16" Grid.Column="0" Text="ArmorLevel:" Margin="0,2" VerticalAlignment="Center"/>
                                <TextBox x:Name="ItemEditArmorLevel" Grid.Row="16" Grid.Column="1" Padding="2" Margin="0,2" Width="80" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="17" Grid.Column="0" Text="Gender:" Margin="0,2" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ItemEditGender" Grid.Row="17" Grid.Column="1" Margin="0,2" Width="100" HorizontalAlignment="Left" SelectedIndex="0">
                                    <ComboBoxItem Content="Both"/><ComboBoxItem Content="Male"/><ComboBoxItem Content="Female"/>
                                </ComboBox>
                                <TextBlock Grid.Row="18" Grid.Column="0" Text="View:" Margin="0,2" VerticalAlignment="Center"/>
                                <TextBox x:Name="ItemEditView" Grid.Row="18" Grid.Column="1" Padding="2" Margin="0,2" Width="80" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="19" Grid.Column="0" Text="AliasName:" Margin="0,2" VerticalAlignment="Center"/>
                                <TextBox x:Name="ItemEditAliasName" Grid.Row="19" Grid.Column="1" Padding="2" Margin="0,2"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <CheckBox x:Name="ItemEditRefineable" Content="Refineable" Margin="0,2,16,2" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ItemEditGradable" Content="Gradable" Margin="0,2,0,2" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Applicable Jobs:" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <WrapPanel x:Name="ItemEditJobsPanel" Margin="0,0,0,8"/>
                            <TextBlock Text="Equip Location:" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <WrapPanel x:Name="ItemEditLocationsPanel" Margin="0,0,0,8"/>
                            <TextBlock Text="Description:" Margin="0,4,0,4"/>
                            <TextBox x:Name="DetailDescription" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50" Margin="0,0,0,8"/>
                            <TextBlock Text="Script (Bonus Effects):" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ComboBox x:Name="ItemEditBonusCombo" Width="200" DisplayMemberPath="DisplayName"/>
                                <TextBox x:Name="ItemEditBonusValue" Width="60" Padding="2" Margin="4,0,0,0" Text="0"/>
                                <Button x:Name="ItemEditAddBonus" Content="+ Add" Padding="8,2" Margin="4,0,0,0" Click="ItemEditAddBonus_Click"/>
                            </StackPanel>
                            <ListBox x:Name="ItemEditBonusList" MinHeight="40" MaxHeight="100" Margin="0,0,0,4"/>
                            <Button Content="Remove Selected" Padding="8,2" Margin="0,0,0,4" HorizontalAlignment="Left" Click="ItemEditRemoveBonus_Click"/>
                            <TextBlock Text="Full Script (authoritative):" FontSize="11" Margin="0,4,0,2"/>
                            <TextBox x:Name="ItemEditScript" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Margin="0,0,0,4"/>
                            <TextBlock Text="EquipScript:" FontSize="11" Margin="0,4,0,2"/>
                            <TextBox x:Name="ItemEditEquipScript" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" Margin="0,0,0,4"/>
                            <TextBlock Text="UnEquipScript:" FontSize="11" Margin="0,4,0,2"/>
                            <TextBox x:Name="ItemEditUnEquipScript" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" Margin="0,0,0,8"/>
                            <Expander x:Name="ItemRelatedFilesExpander" Header="Related files" Margin="0,4,0,4" IsExpanded="False">
                                <ListBox x:Name="ItemRelatedFilesListBox" MinHeight="40" MaxHeight="120" FontFamily="Consolas" FontSize="11"
                                         SelectionChanged="ItemRelatedFilesListBox_SelectionChanged"
                                         MouseDoubleClick="ItemRelatedFilesListBox_MouseDoubleClick"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </Expander>
                            <Expander x:Name="ItemDiffExpander" Header="What changed" Margin="0,8,0,8" Collapsed="DiffExpander_Collapsed" Expanded="DiffExpander_Expanded">
                                <TextBox x:Name="ItemDiffTextBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" MinHeight="80" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </Expander>
                            <Expander Header="Referenced By (NPCs)" Margin="0,0,0,8">
                                <ListView x:Name="ItemReferencesListView" MinHeight="100" MaxHeight="200" MouseDoubleClick="ItemReferences_MouseDoubleClick">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="File" Width="200" DisplayMemberBinding="{Binding SourceFileName}"/>
                                            <GridViewColumn Header="Line" Width="50" DisplayMemberBinding="{Binding LineNumber}"/>
                                            <GridViewColumn Header="Snippet" Width="300" DisplayMemberBinding="{Binding Snippet}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Expander>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="SaveButton" Content="SAVE" Padding="12,6" Margin="0,0,8,0" Click="SaveButton_Click"/>
                                <Button x:Name="ExtractAllRelatedButton" Content="EXTRACT ALL RELATED" Padding="12,6" Margin="0,0,8,0" Click="ExtractAllRelatedButton_Click" Visibility="Collapsed"/>
                                <Button x:Name="OpenInGrfEditorButton" Content="OPEN IN GRF EDITOR" Padding="12,6" Margin="0,0,8,0" Click="OpenInGrfEditorButton_Click" Visibility="Collapsed"/>
                                <Button x:Name="ItemExportButton" Content="COPY BUNDLE" Padding="12,6" Margin="0,0,8,0" Click="ItemExportButton_Click"/>
                                <Button x:Name="ItemDeleteButton" Content="DELETE" Padding="12,6" Margin="0,0,8,0" Click="ItemDeleteButton_Click"/>
                                <Button Content="CANCEL" Padding="12,6" Click="CancelButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Monster details (MONSTERS tab) RMS-style -->
                        <ScrollViewer x:Name="MonsterDetailsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="MONSTER DETAILS" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <!-- Header: Name, AegisName, Mob ID -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Name" FontSize="10" Foreground="#888"/>
                                        <TextBox x:Name="MonsterDetailNameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" Margin="0,0,0,4"/>
                                        <TextBlock Text="AegisName" FontSize="10" Foreground="#888"/>
                                        <TextBox x:Name="MonsterDetailAegisBox" Text="{Binding AegisName, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" Margin="0,0,0,4"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" x:Name="MonsterDetailIdBlock" Text="{Binding Id, StringFormat=Mob-ID# {0}}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <!-- 3-column RMS layout -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Column 0: Stats -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Stats" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="HP:" Margin="0,2"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Hp, UpdateSourceTrigger=PropertyChanged}" Padding="2" Margin="0,2"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Level:" Margin="0,2"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Level, UpdateSourceTrigger=PropertyChanged}" Padding="2" Margin="0,2"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Race:" Margin="0,2"/><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding RaceOptions}" SelectedItem="{Binding Race, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Padding="2" Margin="0,2"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Element:" Margin="0,2"/><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ElementOptions}" SelectedItem="{Binding Element, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Padding="2" Margin="0,2"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Elem Lvl:" Margin="0,2"/><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ElementLevelOptions}" SelectedItem="{Binding ElementLevel, UpdateSourceTrigger=PropertyChanged}" Padding="2" Margin="0,2"/>
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Size:" Margin="0,2"/><ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding Size, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Padding="2" Margin="0,2"/>
                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Hit:" Margin="0,2"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Hit100}" Margin="0,2"/>
                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Flee:" Margin="0,2"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Flee95}" Margin="0,2"/>
                                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Atk:" Margin="0,2"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding AttackRangeText}" Margin="0,2"/>
                                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Def:" Margin="0,2"/><TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Defense, UpdateSourceTrigger=PropertyChanged}" Padding="2" Margin="0,2"/>
                                            <TextBlock Grid.Row="10" Grid.Column="0" Text="MDef:" Margin="0,2"/><TextBox Grid.Row="10" Grid.Column="1" Text="{Binding MagicDefense, UpdateSourceTrigger=PropertyChanged}" Padding="2" Margin="0,2"/>
                                            <TextBlock Grid.Row="11" Grid.Column="0" Text="BaseExp:" Margin="0,2"/><TextBox Grid.Row="11" Grid.Column="1" Text="{Binding BaseExp, UpdateSourceTrigger=PropertyChanged}" Padding="2" Margin="0,2"/>
                                            <TextBlock Grid.Row="12" Grid.Column="0" Text="JobExp:" Margin="0,2"/><TextBox Grid.Row="12" Grid.Column="1" Text="{Binding JobExp, UpdateSourceTrigger=PropertyChanged}" Padding="2" Margin="0,2"/>
                                        </Grid>
                                    </StackPanel>
                                    <!-- Column 1: On Maps + Elements -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="On Maps" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ListBox x:Name="MonsterSpawnListBox" MinHeight="80" MaxHeight="150" ItemsSource="{Binding SpawnGroups}" DisplayMemberPath="DisplayText" Margin="0,0,0,8"/>
                                        <TextBlock Text="Elements" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                        <ItemsControl x:Name="MonsterElementsList" ItemsSource="{Binding ElementRows}" Margin="0,0,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding ElementName}" Grid.Column="0"/>
                                                        <TextBlock Text="{Binding Percent, StringFormat={}{0}%}" Grid.Column="1"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <!-- Column 2: Drops -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Drops" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <DataGrid x:Name="MonsterDropsGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                                  MinHeight="80" Margin="0,0,0,8" HeadersVisibility="Column" ItemsSource="{Binding Drops}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="*"/>
                                                <DataGridTextColumn Header="Rate" Binding="{Binding Rate}" Width="60"/>
                                                <DataGridCheckBoxColumn Header="Steal" Binding="{Binding StealProtected}" Width="50"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="MVP Drops" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                        <DataGrid x:Name="MonsterMvpDropsGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                                  MinHeight="60" Margin="0,0,0,8" HeadersVisibility="Column" ItemsSource="{Binding MvpDrops}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="*"/>
                                                <DataGridTextColumn Header="Rate" Binding="{Binding Rate}" Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Modes" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                <ItemsControl ItemsSource="{Binding Modes}" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,12,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Expander x:Name="MonsterDiffExpander" Header="What changed" Margin="0,8,0,8" Collapsed="DiffExpander_Collapsed" Expanded="DiffExpander_Expanded">
                                    <TextBox x:Name="MonsterDiffTextBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" MinHeight="80" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                </Expander>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                                    <TextBlock Text="MONSTER SKILLS" FontWeight="Bold"/>
                                    <TextBlock Text=" ⓘ" FontSize="12" Foreground="#89B4FA" Cursor="Help"
                                               ToolTipService.ToolTip="Skills this monster uses in combat. Sourced from mob_skill_db.yml. Use Add/Edit/Delete to manage skills in db/import/mob_skill_db.txt. Each skill has a trigger condition (e.g., 'always', 'myhpltmaxrate'), cast rate, delay, and target type."/>
                                </StackPanel>

                                <DataGrid x:Name="MonsterSkillsGrid"
                                          Height="180"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Skill" Binding="{Binding Skill}" Width="2*"/>
                                        <DataGridTextColumn Header="Lv" Binding="{Binding SkillLv}" Width="0.5*"/>
                                        <DataGridTextColumn Header="Rate" Binding="{Binding Rate}" Width="0.8*"/>
                                        <DataGridTextColumn Header="Cast" Binding="{Binding Cast}" Width="0.8*"/>
                                        <DataGridTextColumn Header="Delay" Binding="{Binding Delay}" Width="0.9*"/>
                                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="0.9*"/>
                                        <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="0.9*"/>
                                        <DataGridTextColumn Header="Condition" Binding="{Binding Condition}" Width="2*"/>
                                        <DataGridTextColumn Header="Src" Binding="{Binding Source}" Width="0.9*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <Button Content="Add Skill" Click="MobSkillAdd_Click" Padding="8,4" Margin="0,0,4,0"/>
                                    <Button Content="Edit Skill" Click="MobSkillEdit_Click" Padding="8,4" Margin="0,0,4,0"/>
                                    <Button Content="Delete Skill" Click="MobSkillDelete_Click" Padding="8,4" Margin="0,0,4,0"/>
                                    <Button Content="Open in Editor" Click="MobSkillOpenFile_Click" Padding="8,4" Margin="0,0,0,0"
                                            ToolTip="Open mob_skill_db.txt at the selected skill's source line"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="SLAVES" FontWeight="Bold"/>
                                    <TextBlock Text=" ⓘ" FontSize="12" Foreground="#89B4FA" Cursor="Help"
                                               ToolTipService.ToolTip="Slave monsters summoned by this mob (e.g., Orc Lord summons Orc Warriors). Shows slave ID, count, and name. Defined in the mob's AI behavior — edit via mob_db.yml Slaves field."/>
                                </StackPanel>

                                <DataGrid x:Name="MonsterSlavesGrid"
                                          Height="120"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="0.7*"/>
                                        <DataGridTextColumn Header="Mob" Binding="{Binding MobName}" Width="2.2*"/>
                                        <DataGridTextColumn Header="When" Binding="{Binding When}" Width="2*"/>
                                        <DataGridTextColumn Header="Src" Binding="{Binding Source}" Width="1*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <Button Content="Add Slave" Click="MobSlaveAdd_Click" Padding="8,4" Margin="0,0,4,0"
                                            ToolTip="Add a new NPC_SUMMONSLAVE entry for this mob"/>
                                    <Button Content="Edit Slave" Click="MobSlaveEdit_Click" Padding="8,4" Margin="0,0,4,0"
                                            ToolTip="Edit the underlying mob_skill_db row"/>
                                    <Button Content="Delete Slave" Click="MobSlaveDelete_Click" Padding="8,4" Margin="0,0,4,0"/>
                                    <Button Content="Open in Editor" Click="MobSlaveOpenFile_Click" Padding="8,4"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="MonsterSaveButton" Content="SAVE" Padding="12,6" Margin="0,0,8,0" Click="MonsterSaveButton_Click"/>
                                    <Button x:Name="MonsterExportButton" Content="COPY BUNDLE" Padding="12,6" Margin="0,0,8,0" Click="MonsterExportButton_Click"/>
                                    <Button x:Name="MonsterDeleteButton" Content="DELETE" Padding="12,6" Margin="0,0,8,0" Click="MonsterDeleteButton_Click"/>
                                    <Button Content="CANCEL" Padding="12,6" Click="MonsterCancelButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <!-- NPC details (NPCs tab) -->
                        <StackPanel x:Name="NpcDetailsPanel" Visibility="Collapsed">
                            <TextBlock Text="NPC DETAILS" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="NpcDetailName" Text="NAME: —" Margin="0,0,0,4"/>
                            <TextBlock x:Name="NpcDetailMapPos" Text="Map (X,Y): —" Margin="0,0,0,4"/>
                            <TextBlock x:Name="NpcDetailType" Text="TYPE: —" Margin="0,0,0,8"/>
                            <!-- Shop structured -->
                            <StackPanel x:Name="NpcShopPanel" Visibility="Collapsed">
                                <TextBlock Text="SHOP ITEMS" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                <DataGrid x:Name="NpcShopGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                          MinHeight="100" Margin="0,0,0,8" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Item ID" Binding="{Binding ItemId}" Width="80"/>
                                        <DataGridTextColumn Header="Price (-1=db)" Binding="{Binding Price}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                            <!-- Warp structured -->
                            <StackPanel x:Name="NpcWarpPanel" Visibility="Collapsed">
                                <TextBlock Text="WARP TARGET" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Map:" Grid.Row="0" Grid.Column="0" Margin="0,0,8,4"/>
                                    <TextBox x:Name="NpcWarpMap" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Padding="4,2"/>
                                    <TextBlock Text="X:" Grid.Row="1" Grid.Column="0" Margin="0,0,8,4"/>
                                    <TextBox x:Name="NpcWarpX" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" Padding="4,2"/>
                                    <TextBlock Text="Y:" Grid.Row="2" Grid.Column="0" Margin="0,0,8,4"/>
                                    <TextBox x:Name="NpcWarpY" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" Padding="4,2"/>
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="SCRIPT" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <avalon:TextEditor x:Name="NpcScriptEditor" MinHeight="120" Margin="0,0,0,8"
                                               FontFamily="Consolas" FontSize="12" ShowLineNumbers="True"/>
                            <Expander x:Name="NpcDiffExpander" Header="What changed" Margin="0,8,0,8" Collapsed="DiffExpander_Collapsed" Expanded="DiffExpander_Expanded">
                                <TextBox x:Name="NpcDiffTextBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" MinHeight="80" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </Expander>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="NpcSaveButton" Content="SAVE" Padding="12,6" Margin="0,0,8,0" Click="NpcSaveButton_Click"/>
                                <Button x:Name="NpcExportButton" Content="COPY BUNDLE" Padding="12,6" Margin="0,0,8,0" Click="NpcExportButton_Click"/>
                                <Button Content="CANCEL" Padding="12,6" Click="NpcCancelButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- FILE ASSIGNMENT tab -->
                        <ScrollViewer x:Name="FileAssignmentPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="FILE ASSIGNMENT" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Workspace profile:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="FileAssignProfileCombo" MinWidth="160" Margin="0,0,8,0" SelectionChanged="FileAssignProfileCombo_SelectionChanged" DisplayMemberPath="Name"/>
                                    <Button Content="New Profile" Padding="8,4" Margin="0,0,4,0" Click="FileAssignNewProfile_Click"/>
                                    <Button Content="Save Profile" Padding="8,4" Margin="0,0,4,0" Click="FileAssignSaveProfile_Click"/>
                                    <Button Content="Delete Profile" Padding="8,4" Margin="0,0,4,0" Click="FileAssignDeleteProfile_Click"/>
                                    <Button Content="Apply" Padding="8,4" Click="FileAssignApplyProfile_Click"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="RAthena location:" VerticalAlignment="Center" Margin="0,4"
                                           ToolTip="Server DB root (rAthena). RoDbEditor reads base data from db/re or db/pre-re here and writes all edits to db/import/*.yml only."/>
                                    <TextBox x:Name="FileAssignRathenaPath" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Padding="4,2" Margin="0,4" VerticalContentAlignment="Center"/>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="4,4,0,4">
                                        <Button Content="Set..." Padding="8,4" Margin="0,0,4,0" Click="FileAssignSetRathena_Click"/>
                                        <Button Content="Open folder" Padding="8,4" Click="FileAssignOpenRathena_Click"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Client root:" VerticalAlignment="Center" Margin="0,4"
                                               ToolTip="Base client installation (contains System/ and GRF files). In Patch-only mode this is treated as read-mostly; in Live-client mode some writers may update files directly here."/>
                                    <TextBox x:Name="FileAssignClientRootPath" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Padding="4,2" Margin="0,4" VerticalContentAlignment="Center"/>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="4,4,0,4">
                                        <Button Content="Set..." Padding="8,4" Margin="0,0,4,0" Click="FileAssignSetClientRoot_Click"/>
                                        <Button Content="Open folder" Padding="8,4" Click="FileAssignOpenClientRoot_Click"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Patch output:" VerticalAlignment="Center" Margin="0,4"
                                               ToolTip="Patch output root. RoDbEditor writes overlay System/ and data/ files here (e.g. itemInfo_rodbeditor.lua, npcidentity/jobname overlays) when generating patches."/>
                                    <TextBox x:Name="FileAssignPatchRootPath" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Padding="4,2" Margin="0,4" VerticalContentAlignment="Center"/>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="4,4,0,4">
                                        <Button Content="Set..." Padding="8,4" Margin="0,0,4,0" Click="FileAssignSetPatchRoot_Click"/>
                                        <Button Content="Open folder" Padding="8,4" Click="FileAssignOpenPatchRoot_Click"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Client-Side ItemInfo Lua:" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox x:Name="FileAssignItemInfoPath" Grid.Row="3" Grid.Column="1" IsReadOnly="True" Padding="4,2" Margin="0,4" VerticalContentAlignment="Center"/>
                                    <Button Grid.Row="3" Grid.Column="2" Content="Open folder" Padding="8,4" Margin="4,4,0,4" Click="FileAssignOpenItemInfo_Click"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Client-Side accessory:" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox x:Name="FileAssignAccessoryPath" Grid.Row="4" Grid.Column="1" IsReadOnly="True" Padding="4,2" Margin="0,4" VerticalContentAlignment="Center"/>
                                    <Button Grid.Row="4" Grid.Column="2" Content="Open folder" Padding="8,4" Margin="4,4,0,4" Click="FileAssignOpenAccessory_Click"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="SPRITE ASSETS:" VerticalAlignment="Center" Margin="0,4"
                                               ToolTip="Effective sprite source paths resolved from the GRF list. Sprites are read from these GRFs; new sprites are written to the configured custom GRF."/>
                                    <TextBox x:Name="FileAssignSpritePath" Grid.Row="5" Grid.Column="1" IsReadOnly="True" Padding="4,2" Margin="0,4" VerticalContentAlignment="Center"/>
                                    <Button Grid.Row="5" Grid.Column="2" Content="Open folder" Padding="8,4" Margin="4,4,0,4" Click="FileAssignOpenSprite_Click"/>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Custom GRF:" VerticalAlignment="Center" Margin="0,4"
                                               ToolTip="Writable custom GRF (TargetGrfPath or ClientRootPath + TargetGrfFileName). RoDbEditor adds sprites and accessory tables here; base GRFs like data.grf remain read-only."/>
                                    <TextBox x:Name="FileAssignGrfPath" Grid.Row="6" Grid.Column="1" IsReadOnly="True" Padding="4,2" Margin="0,4" VerticalContentAlignment="Center"/>
                                    <Button Grid.Row="6" Grid.Column="2" Content="Open in GRF Editor" Padding="8,4" Margin="4,4,0,4" Click="FileAssignOpenGrf_Click"/>
                                </Grid>
                                <Expander Header="Custom Item Pipeline Reference" Margin="0,12,0,0" IsExpanded="False">
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,4">
                                        <Run Text="1. rAthena location: server db/import (item_db.yml, mob_db.yml, etc.). Use File → Select rAthena folder to set."/>
                                        <LineBreak/>
                                        <Run Text="2. Client-Side ItemInfo Lua: client System folder (e.g. SystemEN) for iteminfo_rodbeditor.lua overlay."/>
                                        <LineBreak/>
                                        <Run Text="3. Client-Side accessory: client System for accid.lua / accessoryid.lua."/>
                                        <LineBreak/>
                                        <Run Text="4. SPRITE ASSETS: client data\sprite (or data) for sprite preview in ITEMS/MONSTERS tabs."/>
                                        <LineBreak/>
                                        <Run Text="5. Custom GRF: target GRF for writing (custom.grf or path from config). Open in GRF Editor to inspect/pack."/>
                                    </TextBlock>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Operations Log | Diagnostics Panel -->
        <Expander Grid.Row="3" Header="Operations Log | Diagnostics" IsExpanded="True" Margin="6">
            <TabControl>
                <TabItem Header="Operations Log">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                            <Button Content="Undo" Click="UndoButton_Click" Padding="8,3" Margin="0,0,6,0"/>
                            <Button Content="Delete" Click="DeleteSelectedButton_Click" Padding="8,3" Margin="0,0,6,0"/>
                            <Button Content="Delete Latest Entry" Click="DeleteLatestEntryButton_Click" Padding="8,3"/>
                        </StackPanel>
                        <ListView Grid.Row="1" x:Name="OperationsListView" MaxHeight="200" MinHeight="100">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Time" Width="70" DisplayMemberBinding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"/>
                                    <GridViewColumn Header="Action" Width="70" DisplayMemberBinding="{Binding DisplayAction}"/>
                                    <GridViewColumn Header="Entity" Width="180" DisplayMemberBinding="{Binding DisplayEntity}"/>
                                    <GridViewColumn Header="File" Width="120" DisplayMemberBinding="{Binding DisplayFile}"/>
                                    <GridViewColumn Header="Id" Width="50" DisplayMemberBinding="{Binding Id}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>
                <TabItem Header="Diagnostics">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                            <Button Content="Copy Selected" Click="CopySelectedDiagnostics_Click" Padding="8,3" Margin="0,0,6,0"/>
                            <Button Content="Copy All" Click="CopyAllDiagnostics_Click" Padding="8,3"/>
                        </StackPanel>
                        <ListView Grid.Row="1" x:Name="DiagnosticsListView" MaxHeight="200" MinHeight="100" MouseDoubleClick="DiagnosticsListView_MouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Severity" DisplayMemberBinding="{Binding Severity}" Width="80"/>
                                    <GridViewColumn Header="Code" DisplayMemberBinding="{Binding Code}" Width="60"/>
                                    <GridViewColumn Header="Message" DisplayMemberBinding="{Binding Message}" Width="400"/>
                                    <GridViewColumn Header="File" DisplayMemberBinding="{Binding FilePath}" Width="250"/>
                                    <GridViewColumn Header="Line" DisplayMemberBinding="{Binding LineNumber}" Width="50"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>
            </TabControl>
        </Expander>
    </Grid>
</Window>
