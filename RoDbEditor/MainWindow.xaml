                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="SubType:" Margin="0,2" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="ExtItemSubType" Grid.Row="4" Grid.Column="1" IsEditable="True" Margin="0,2"/>
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Buy:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtItemBuy" Grid.Row="5" Grid.Column="1" Padding="2" Margin="0,2" Width="100" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Sell:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtItemSell" Grid.Row="6" Grid.Column="1" Padding="2" Margin="0,2" Width="100" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Weight:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtItemWeight" Grid.Row="7" Grid.Column="1" Padding="2" Margin="0,2" Width="100" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Attack:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtItemAttack" Grid.Row="8" Grid.Column="1" Padding="2" Margin="0,2" Width="100" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="9" Grid.Column="0" Text="MagicAttack:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtItemMagicAttack" Grid.Row="9" Grid.Column="1" Padding="2" Margin="0,2" Width="100" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Defense:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtItemDefense" Grid.Row="10" Grid.Column="1" Padding="2" Margin="0,2" Width="100" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Range:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtItemRange" Grid.Row="11" Grid.Column="1" Padding="2" Margin="0,2" Width="100" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Required Lvl:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtItemReqLevel" Grid.Row="12" Grid.Column="1" Padding="2" Margin="0,2" Width="100" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="13" Grid.Column="0" Text="EquipLevelMax:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtItemEquipLevelMax" Grid.Row="13" Grid.Column="1" Padding="2" Margin="0,2" Width="100" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="14" Grid.Column="0" Text="Slots:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtItemSlots" Grid.Row="14" Grid.Column="1" Padding="2" Margin="0,2" Width="60" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="15" Grid.Column="0" Text="WeaponLevel:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtItemWeaponLevel" Grid.Row="15" Grid.Column="1" Padding="2" Margin="0,2" Width="100" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="16" Grid.Column="0" Text="ArmorLevel:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtItemArmorLevel" Grid.Row="16" Grid.Column="1" Padding="2" Margin="0,2" Width="100" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="17" Grid.Column="0" Text="Gender:" Margin="0,2" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="ExtItemGender" Grid.Row="17" Grid.Column="1" Margin="0,2" Width="100" HorizontalAlignment="Left" SelectedIndex="0">
                                            <ComboBoxItem Content="Both"/>
                                            <ComboBoxItem Content="Male"/>
                                            <ComboBoxItem Content="Female"/>
                                        </ComboBox>
                                        <TextBlock Grid.Row="18" Grid.Column="0" Text="View:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtItemView" Grid.Row="18" Grid.Column="1" Padding="2" Margin="0,2" Width="100" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="19" Grid.Column="0" Text="AliasName:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtItemAliasName" Grid.Row="19" Grid.Column="1" Padding="2" Margin="0,2"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                        <CheckBox x:Name="ExtItemRefineable" Content="Refineable" Margin="0,2,16,2" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="ExtItemGradable" Content="Gradable" Margin="0,2,0,2" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Applicable Jobs -->
                                    <TextBlock Text="Applicable Jobs:" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <WrapPanel x:Name="ExtItemJobsPanel" Margin="0,0,0,8"/>
                                    <!-- Equip Location -->
                                    <TextBlock Text="Equip Location:" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                    <WrapPanel x:Name="ExtItemLocationsPanel" Margin="0,0,0,8"/>
                                    <!-- Description -->
                                    <TextBlock Text="Description:" Margin="0,4,0,4"/>
                                    <TextBox x:Name="ExtItemDescription" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Margin="0,0,0,8"/>
                                    <!-- Script Builder -->
                                    <TextBlock Text="Script (Bonus Effects):" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ComboBox x:Name="ExtItemBonusCombo" Width="200" DisplayMemberPath="DisplayName"/>
                                        <TextBox x:Name="ExtItemBonusValue" Width="60" Padding="2" Margin="4,0,0,0" Text="0"/>
                                        <Button Content="+ Add" Padding="8,2" Margin="4,0,0,0" Click="ExtItemAddBonus_Click"/>
                                    </StackPanel>
                                    <ListBox x:Name="ExtItemBonusList" MinHeight="40" MaxHeight="120" Margin="0,0,0,4"/>
                                    <Button Content="Remove Selected" Padding="8,2" Margin="0,0,0,4" HorizontalAlignment="Left" Click="ExtItemRemoveBonus_Click"/>
                                    <TextBlock Text="Generated Script:" FontSize="11" Margin="0,4,0,2"/>
                                    <TextBox x:Name="ExtItemScriptPreview" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                             TextWrapping="Wrap" MinHeight="30" Margin="0,0,0,4" Background="#f5f5f5"/>
                                    <TextBlock Text="Full Script (authoritative):" FontSize="11" Margin="0,4,0,2"/>
                                    <TextBox x:Name="ExtItemScript" FontFamily="Consolas" FontSize="11"
                                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50" Margin="0,0,0,4"/>
                                    <TextBlock Text="EquipScript:" FontSize="11" Margin="0,4,0,2"/>
                                    <TextBox x:Name="ExtItemEquipScript" FontFamily="Consolas" FontSize="11"
                                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" Margin="0,0,0,4"/>
                                    <TextBlock Text="UnEquipScript:" FontSize="11" Margin="0,4,0,2"/>
                                    <TextBox x:Name="ExtItemUnEquipScript" FontFamily="Consolas" FontSize="11"
                                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" Margin="0,0,0,8"/>
                                </StackPanel>

                                <!-- MONSTER PROPERTIES (visible when Entity=MONSTER) -->
                                <StackPanel x:Name="ExtractedMonsterPropertiesPanel" Visibility="Collapsed">
                                    <TextBlock Text="MONSTER PROPERTIES" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Mob ID:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtMobId" Grid.Row="0" Grid.Column="1" Padding="2" Margin="0,2"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="AegisName:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtMobAegisName" Grid.Row="1" Grid.Column="1" Padding="2" Margin="0,2"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Name:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtMobName" Grid.Row="2" Grid.Column="1" Padding="2" Margin="0,2"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Level:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtMobLevel" Grid.Row="3" Grid.Column="1" Padding="2" Margin="0,2" Width="60" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="HP:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtMobHp" Grid.Row="4" Grid.Column="1" Padding="2" Margin="0,2" Width="100" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Base EXP:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtMobBaseExp" Grid.Row="5" Grid.Column="1" Padding="2" Margin="0,2" Width="100" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Job EXP:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtMobJobExp" Grid.Row="6" Grid.Column="1" Padding="2" Margin="0,2" Width="100" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Race:" Margin="0,2" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="ExtMobRace" Grid.Row="7" Grid.Column="1" IsEditable="True" Margin="0,2">
                                            <ComboBoxItem Content="Formless"/>
                                            <ComboBoxItem Content="Undead"/>
                                            <ComboBoxItem Content="Brute"/>
                                            <ComboBoxItem Content="Plant"/>
                                            <ComboBoxItem Content="Insect"/>
                                            <ComboBoxItem Content="Fish"/>
                                            <ComboBoxItem Content="Demon"/>
                                            <ComboBoxItem Content="Demihuman"/>
                                            <ComboBoxItem Content="Angel"/>
                                            <ComboBoxItem Content="Dragon"/>
                                        </ComboBox>
                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Element:" Margin="0,2" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="ExtMobElement" Grid.Row="8" Grid.Column="1" IsEditable="True" Margin="0,2">
                                            <ComboBoxItem Content="Neutral"/>
                                            <ComboBoxItem Content="Water"/>
                                            <ComboBoxItem Content="Earth"/>
                                            <ComboBoxItem Content="Fire"/>
                                            <ComboBoxItem Content="Wind"/>
                                            <ComboBoxItem Content="Poison"/>
                                            <ComboBoxItem Content="Holy"/>
                                            <ComboBoxItem Content="Shadow"/>
                                            <ComboBoxItem Content="Ghost"/>
                                            <ComboBoxItem Content="Undead"/>
                                        </ComboBox>
                                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Size:" Margin="0,2" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="ExtMobSize" Grid.Row="9" Grid.Column="1" IsEditable="True" Margin="0,2" Width="100" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="Small"/>
                                            <ComboBoxItem Content="Medium"/>
                                            <ComboBoxItem Content="Large"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>

                                <!-- NPC PROPERTIES (visible when Entity=NPC) -->
                                <StackPanel x:Name="ExtractedNpcPropertiesPanel" Visibility="Collapsed">
                                    <TextBlock Text="NPC PROPERTIES" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtNpcName" Grid.Row="0" Grid.Column="1" Padding="2" Margin="0,2"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Sprite ID:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtNpcSpriteId" Grid.Row="1" Grid.Column="1" Padding="2" Margin="0,2"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Map:" Margin="0,2" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExtNpcMap" Grid.Row="2" Grid.Column="1" Padding="2" Margin="0,2"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Save/Export/Cancel -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                    <Button x:Name="ExtractedViewInGrfButton" Content="VIEW IN GRF" Padding="12,6" Margin="0,0,8,0"
                                            Click="ExtractedViewInGrfButton_Click" ToolTip="Open file in GRF Editor or Explorer"/>
                                    <Button x:Name="ExtractedSaveButton" Content="SAVE" Padding="12,6" Margin="0,0,8,0"
                                            Click="ExtractedSaveButton_Click"/>
                                    <Button x:Name="ExtractedExportButton" Content="EXPORT" Padding="12,6" Margin="0,0,8,0"
                                            Click="ExtractedExportButton_Click"/>
                                    <Button Content="CANCEL" Padding="12,6" Click="ExtractedCancelButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Operations Log | Diagnostics Panel -->
        <Expander Grid.Row="3" Header="Operations Log | Diagnostics" IsExpanded="True" Margin="6">
            <TabControl>
                <TabItem Header="Operations Log">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                            <Button Content="Undo" Click="UndoButton_Click" Padding="8,3" Margin="0,0,6,0"/>
                            <Button Content="Delete" Click="DeleteSelectedButton_Click" Padding="8,3" Margin="0,0,6,0"/>
                            <Button Content="Delete Latest Entry" Click="DeleteLatestEntryButton_Click" Padding="8,3"/>
                        </StackPanel>
                        <ListView Grid.Row="1" x:Name="OperationsListView" MaxHeight="200" MinHeight="100">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Time" Width="70" DisplayMemberBinding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"/>
                                    <GridViewColumn Header="Action" Width="70" DisplayMemberBinding="{Binding DisplayAction}"/>
                                    <GridViewColumn Header="Entity" Width="180" DisplayMemberBinding="{Binding DisplayEntity}"/>
                                    <GridViewColumn Header="File" Width="120" DisplayMemberBinding="{Binding DisplayFile}"/>
                                    <GridViewColumn Header="Id" Width="50" DisplayMemberBinding="{Binding Id}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>
                <TabItem Header="Diagnostics">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                            <Button Content="Copy Selected" Click="CopySelectedDiagnostics_Click" Padding="8,3" Margin="0,0,6,0"/>
                            <Button Content="Copy All" Click="CopyAllDiagnostics_Click" Padding="8,3"/>
                        </StackPanel>
                        <ListView Grid.Row="1" x:Name="DiagnosticsListView" MaxHeight="200" MinHeight="100" MouseDoubleClick="DiagnosticsListView_MouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Severity" DisplayMemberBinding="{Binding Severity}" Width="80"/>
                                    <GridViewColumn Header="Code" DisplayMemberBinding="{Binding Code}" Width="60"/>
                                    <GridViewColumn Header="Message" DisplayMemberBinding="{Binding Message}" Width="400"/>
                                    <GridViewColumn Header="File" DisplayMemberBinding="{Binding FilePath}" Width="250"/>
                                    <GridViewColumn Header="Line" DisplayMemberBinding="{Binding LineNumber}" Width="50"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>
            </TabControl>
        </Expander>
    </Grid>
</Window>
